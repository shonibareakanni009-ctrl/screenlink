{
  "manifest_version": 2,
  "name": "ScreenLink",
  "version": "1.4.0",
  "description": "ScreenLink: full-screen mirror, taps, swipes, and typing to an Android phone over Wi-Fi.",
  "app": {
    "background": {
      "scripts": ["background.js"]
    }
  },
  "permissions": [
    "audioCapture",
    "system.network",
    "storage",
    "http://*/*",
    "https://*/*",
    {"fileSystem": ["write", "retainEntries"]}
  ],
  "sockets": {
    "tcpServer": {
      "listen": [":8080"]
    },
    "tcp": {
      "connect": ["*"]
    }
  }
}
