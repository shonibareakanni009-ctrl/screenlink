{
  "manifest_version": 2,
  "name": "ScreenLink",
  "version": "1.2.1",
  "description": "ScreenLink: view and control an Android phone from a Chromebook over Wi-Fi. Chrome 75 compatible.",
  "app": {
    "background": {
      "scripts": ["background.js"]
    }
  },
  "permissions": [
    "audioCapture",
    "system.network",
    "storage",
    {"fileSystem": ["write", "retainEntries"]}
  ],
  "sockets": {
    "tcpServer": {
      "listen": [":8080"]
    },
    "tcp": {
      "connect": ["*"]
    }
  }
}
